{
  "name": "@moralec/tinycode",
  "publishConfig": {
    "access": "public"
  },
  "version": "1.1.0",
  "description": "A Pi extension that keeps the context small, so local models finish coding tasks in a 16k window where plain Pi runs out of room",
  "license": "Apache-2.0",
  "files": [
    "extensions/",
    "src/",
    "docs/",
    "install.sh",
    "install.ps1",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "ROADMAP.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moralec/tinyCode.git"
  },
  "homepage": "https://github.com/moralec/tinyCode",
  "bugs": {
    "url": "https://github.com/moralec/tinyCode/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "llama.cpp",
    "local-llm",
    "coding-agent"
  ],
  "type": "module",
  "pi": {
    "extensions": [
      "./extensions/tinycode/index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test test/unit/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
